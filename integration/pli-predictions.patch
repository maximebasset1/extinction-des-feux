+                                    <td class="py-2 pr-2">
+                                        <a href="<%= d.driverId ? '/driver/' + d.driverId : '#' %>" class="flex items-center gap-2 hover:underline">
+                                            <span class="inline-block h-5 w-1 rounded-sm <%= d.constructorId ? 'bg-' + d.constructorId : 'bg-gray-500' %>"></span>
+                                            <span class="font-bold"><%= d.lastName %></span>
+                                            <span class="text-t-s-<%= theme %> hidden sm:inline"><%= d.equipe %></span>
+                                        </a>
+                                    </td>
+                                    <td class="py-2 pr-2">
+                                        <span class="flex items-center gap-2">
+                                            <span class="h-2 grow rounded-full bg-gray-500/20 overflow-hidden"><span class="block h-2 rounded-full <%= d.constructorId ? 'bg-' + d.constructorId : 'bg-main-color' %> <%= predictionFormat.barWidth(d.probability, maxPole) %>"></span></span>
+                                            <span class="w-10 text-right font-bold"><%= predictionFormat.probability(d.probability) %></span>
+                                        </span>
+                                    </td>
+                                    <td class="py-2">
+                                        <span class="flex items-center gap-2">
+                                            <span class="h-2 grow rounded-full bg-gray-500/20 overflow-hidden"><span class="block h-2 rounded-full <%= d.constructorId ? 'bg-' + d.constructorId : 'bg-main-color' %> <%= predictionFormat.barWidth(d.winProbability, maxWin) %>"></span></span>
+                                            <span class="w-10 text-right font-bold"><%= predictionFormat.probability(d.winProbability) %></span>
+                                        </span>
+                                    </td>
+                                </tr>
+                                <% }) %>
+                            </tbody>
+                        </table>
+                    </div>
+                </section>
+                <% } %>
+
+                <!-- model vs reality -->
+                <section id="history" class="bg-s-<%= theme %> rounded-3xl p-4 md:p-6">
+                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
