+                            <tbody>
+                                <% [...p.history[historySeason]].reverse().forEach(gp => { %>
+                                <tr class="border-b border-gray-600/40">
+                                    <td class="py-2 pr-2">
+                                        <span class="flex items-center gap-2">
+                                            <% if (gp.countryId) { %><img src="/img/countryFlags/<%= gp.countryId %>.svg" class="h-4 w-auto rounded-xs" alt="" /><% } %>
+                                            <% if (gp.raceId) { %><a href="/retrogpdetails/<%= historySeason %>/<%= gp.raceId %>" class="hover:underline"><%= gp.name %></a><% } else { %><%= gp.name %><% } %>
+                                            <% if (gp.isWet) { %><span class="text-sky-400 text-xs" title="<%= __('predictions.wet_session') %>">wet</span><% } %>
+                                        </span>
+                                    </td>
+                                    <td class="py-2 pr-2 font-bold"><%= gp.poleSitter ? gp.poleSitter.lastName : '–' %></td>
+                                    <td class="py-2 pr-2 text-right font-bold"><%= predictionFormat.probability(gp.poleSitterProbability) %></td>
+                                    <td class="py-2 pr-2 hidden sm:table-cell"><%= gp.favourite ? gp.favourite.lastName : '–' %></td>
+                                    <td class="py-2 hidden md:table-cell"><%= gp.winner ? gp.winner.lastName : '–' %></td>
+                                </tr>
+                                <% }) %>
+                            </tbody>
+                        </table>
+                    </div>
+                </section>
+
+                <!-- track record -->
+                <section class="bg-s-<%= theme %> rounded-3xl p-4 md:p-6">
