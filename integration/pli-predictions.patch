--- /dev/null
+++ b/routes/predictions.js
@@ -0,0 +1,18 @@
+const express = require('express');
+const router = express.Router();
+
+// functions
+const getPredictionsData = require('../utils/predictions/getPredictionsData');
+
+router.get('/predictions', async (req, res) => {
+    try {
+        var predictions = await getPredictionsData();
+        const requestedSeason = Number(req.query.season);
+        const season = predictions.historySeasons.includes(requestedSeason) ? requestedSeason : predictions.historySeasons[0];
+        res.render('predictions/predictions', { predictions: predictions, historySeason: season, pageTitle: 'PLI - Predictions' });
+    } catch (error) {
+        res.render('security/error', { textError: '/predictions route, error during execution', error: error });
+    }
+});
+
+module.exports = router;
diff --git a/utils/predictions/getDriverPrediction.js b/utils/predictions/getDriverPrediction.js
new file mode 100644
index 0000000..e1a0555
--- /dev/null
+++ b/utils/predictions/getDriverPrediction.js
@@ -0,0 +1,32 @@
+const getPredictionsData = require('./getPredictionsData');
+
+/**
+ * @description Returns the next grand prix prediction of one driver for the driver page.
+ * @async
+ * @param {string} driverId - f1db driver id.
+ * @returns {Promise<Object>} Prediction with isAvailable flag, ranks and probabilities.
+ */
+async function getDriverPrediction(driverId) {
+    try {
+        const data = await getPredictionsData();
+        const index = data.field.findIndex(p => p.driverId === driverId);
+        if (index === -1) return { isAvailable: false };
+        const entry = data.field[index];
+        const winRank = data.winFavourites.findIndex(p => p.driverId === driverId) + 1;
+        return {
+            isAvailable: true,
+            grandPrix: data.grandPrix,
+            poleProbability: entry.probability,
+            poleRank: index + 1,
+            winProbability: entry.winProbability,
+            winRank: winRank,
+            fieldSize: data.field.length,
+        };
+    } catch (error) {
+        // the driver page must still render when the prediction engine is down.
+        console.error(new Error('getDriverPrediction unavailable', { cause: error }));
+        return { isAvailable: false };
+    }
+}
+
+module.exports = getDriverPrediction;
diff --git a/utils/predictions/getPredictionsData.js b/utils/predictions/getPredictionsData.js
new file mode 100644
index 0000000..5da82a4
--- /dev/null
+++ b/utils/predictions/getPredictionsData.js
@@ -0,0 +1,212 @@
+const config = require('../../config.json');
+const drivers = require('../../data/f1db/f1db-drivers.json');
+const entrantsDrivers = require('../../data/f1db/f1db-seasons-entrants-drivers.json');
+const grandsPrix = require('../../data/f1db/f1db-grands-prix.json');
+const races = require('../../data/f1db/f1db-races.json');
+
+const settings = config.predictions;
+// local development can point to a copy of the engine files.
+const baseUrl = process.env.PREDICTIONS_BASE_URL || settings.baseUrl;
+
+// in-memory cache: the engine only publishes new numbers a few times per hour.
+let cache = { data: null, fetchedAt: 0 };
+
+/**
+ * @description Downloads one JSON file published by the prediction engine.
+ * @async
+ * @param {string} name - File name without extension (next, history...).
+ * @returns {Promise<Object>} Parsed JSON content.
+ */
+async function fetchEngineFile(name) {
+    const url = `${baseUrl}/${name}.json`;
+    const response = await fetch(url, { signal: AbortSignal.timeout(settings.requestTimeoutMs) });
+    if (!response.ok) {
+        throw new Error(`prediction engine returned ${response.status} for ${url}`);
+    }
+    return response.json();
+}
+
+/**
+ * @description Builds a lookup from three-letter driver codes to f1db drivers for one season.
+ * @param {number} year - Season year.
+ * @returns {Map<string, Object>} Map of code to driver identity and constructor.
+ */
+function buildDriverLookup(year) {
+    const seasonEntries = entrantsDrivers.filter(e => e.year === year && !e.testDriver);
+    const lookup = new Map();
+    seasonEntries.forEach(entry => {
+        const driver = drivers.find(d => d.id === entry.driverId);
+        if (!driver || !driver.abbreviation) return;
+        const lastRound = Math.max(...entry.rounds);
+        const known = lookup.get(driver.abbreviation);
+        // keep the team a driver raced for most recently when he changed team mid-season.
+        if (known && known.lastRound >= lastRound) return;
+        lookup.set(driver.abbreviation, {
+            driverId: driver.id,
+            firstName: driver.firstName,
+            lastName: driver.lastName,
+            constructorId: entry.constructorId,
+            lastRound: lastRound,
+        });
+    });
+    return lookup;
+}
+
+/**
+ * @description Finds the f1db grand prix matching an engine grand prix name (e.g. "British").
+ * @param {string} engineName - Grand prix name as published by the engine.
+ * @returns {Object|null} f1db grand prix record.
+ */
+function findGrandPrix(engineName) {
+    const aliasId = settings.grandPrixAliases[engineName];
+    if (aliasId) return grandsPrix.find(g => g.id === aliasId) || null;
+    return grandsPrix.find(g => g.fullName === `${engineName} Grand Prix` || g.name === engineName) || null;
+}
+
+/**
+ * @description Adds f1db identity (id, names, team) to an engine driver entry.
+ * @param {Object} entry - Engine entry with a code field.
+ * @param {Map<string, Object>} lookup - Driver lookup for the season.
+ * @returns {Object} Entry enriched with f1db fields, original fields untouched.
+ */
+function withIdentity(entry, lookup) {
+    const identity = lookup.get(entry.code) || {};
+    return {
+        ...entry,
+        driverId: identity.driverId || null,
+        firstName: identity.firstName || entry.nom || entry.code,
+        lastName: identity.lastName || entry.famille || entry.code,
+        constructorId: identity.constructorId || null,
+    };
+}
+
+/**
+ * @description Formats an engine grand prix for display with its flag and circuit layout.
+ * @param {number} year - Season year.
+ * @param {string} engineName - Grand prix name as published by the engine.
+ * @returns {{name: string, countryId: string|null, circuitLayoutId: string|null, raceId: number|null}} Display data.
+ */
+function describeGrandPrix(year, engineName) {
+    const grandPrix = findGrandPrix(engineName);
+    if (!grandPrix) return { name: `${engineName} GP`, countryId: null, circuitLayoutId: null, raceId: null };
+    const race = races.find(r => r.year === year && r.grandPrixId === grandPrix.id) || {};
+    return {
+        name: grandPrix.shortName,
+        countryId: grandPrix.countryId,
+        circuitLayoutId: race.circuitLayoutId || null,
+        raceId: race.id || null,
+    };
+}
+
+/**
+ * @description Ranks a driver in a past qualifying according to the pre-weekend probabilities.
+ * @param {Object[]} pilots - Engine drivers of one grand prix.
+ * @param {string} code - Driver code to rank.
+ * @returns {number} 1-based rank, 0 when the driver is absent.
+ */
+function rankBeforeWeekend(pilots, code) {
+    const sorted = [...pilots].sort((a, b) => (b.avant || 0) - (a.avant || 0));
+    return sorted.findIndex(p => p.code === code) + 1;
+}
+
+/**
+ * @description Turns engine files into the view model used by the predictions pages.
+ * @param {Object} files - Raw engine files keyed by name.
+ * @returns {Object} View model.
+ */
+function buildViewModel(files) {
+    const { next, history, performance, journal } = files;
+    const lookup = buildDriverLookup(next.saison);
+    const hasPracticeData = next.pole.some(p => p.apres !== null && p.apres !== undefined);
+    const poleKey = hasPracticeData ? 'apres' : 'avant';
+    const pole = next.pole
+        .map(p => withIdentity({ ...p, probability: p[poleKey] }, lookup))
+        .sort((a, b) => b.probability - a.probability);
+    const win = next.victoire
+        .map(p => withIdentity({ ...p, probability: p.proba }, lookup))
+        .sort((a, b) => b.probability - a.probability);
+    const winByCode = new Map(win.map(p => [p.code, p.probability]));
+    const field = pole.map(p => ({ ...p, winProbability: winByCode.get(p.code) || 0 }));
+
+    const seasons = settings.historySeasons.filter(year => history.saisons[year]);
+    const pastGrandsPrix = seasons.reduce((acc, year) => {
+        const seasonLookup = buildDriverLookup(year);
+        const list = history.saisons[year].map(gp => {
+            const pilots = gp.pilotes.map(p => withIdentity(p, seasonLookup));
+            const poleSitter = pilots.find(p => p.code === gp.poleman) || null;
+            const winner = pilots.find(p => p.code === gp.vainqueur) || null;
+            const favourite = [...pilots].sort((a, b) => ((b.apres ?? b.avant) || 0) - ((a.apres ?? a.avant) || 0))[0] || null;
+            return {
+                ...describeGrandPrix(year, gp.gp),
+                date: gp.date,
+                isWet: gp.pluie,
+                poleSitter: poleSitter,
+                poleSitterProbability: poleSitter ? (poleSitter.apres ?? poleSitter.avant) : null,
+                poleSitterColor: history.pilotes[gp.poleman] ? history.pilotes[gp.poleman].couleur : null,
+                favourite: favourite,
+                winner: winner,
+                pilots: pilots,
+            };
+        });
+        return { ...acc, [year]: list };
+    }, {});
+
+    const trackRecordRaces = settings.trackRecordSeasons.flatMap(year => history.saisons[year] || []).filter(gp => gp.poleman);
+    const ranks = trackRecordRaces.map(gp => rankBeforeWeekend(gp.pilotes, gp.poleman));
+    const randomGain = performance.gains.find(g => g.modele === 'avant le week-end' && g.periode === '2024-2025' && g.contre.startsWith('hasard'));
+    const raceGain = performance.course && performance.course.gains ? performance.course.gains.find(g => g.periode === String(next.saison)) : null;
+
+    return {
+        updatedAt: next.maj_utc,
+        season: next.saison,
+        grandPrix: describeGrandPrix(next.saison, next.gp),
+        sessions: next.sessions,
+        isScheduleEstimated: next.horaires_estimes,
+        isSeasonOver: next.saison_terminee,
+        isQualifyingDone: next.qualif_disputee,
+        isEarlySeason: next.debut_saison,
+        hasPracticeData: hasPracticeData,
+        weather: next.meteo || null,
+        poleSitter: next.poleman ? withIdentity(next.poleman, lookup) : null,
+        grid: pole.slice(0, settings.gridSize),
+        field: field,
+        winFavourites: win,
+        raceResult: (next.arrivee || []).map(p => withIdentity(p, lookup)),
+        history: pastGrandsPrix,
+        historySeasons: seasons,
+        trackRecord: {
+            races: trackRecordRaces.length,
+            poleSitterInTopThree: ranks.filter(r => r > 0 && r <= settings.topRankCount).length,
+            favouriteTookPole: ranks.filter(r => r === 1).length,
+            beatsRandom: Boolean(randomGain && randomGain.ic95_bas > 0),
+            raceGain: raceGain,
+        },
+        journal: (journal.evaluations || []).map(e => ({ ...e, grandPrix: describeGrandPrix(e.season, e.grand_prix) })).reverse(),
+        engineRepositoryUrl: settings.engineRepositoryUrl,
+        minDisplayedProbability: settings.minDisplayedProbability,
+        rainDisplayThreshold: settings.rainDisplayThreshold,
+    };
+}
+
+/**
+ * @description Returns the predictions view model, cached for config.predictions.cacheDurationMs.
+ * @async
+ * @returns {Promise<Object>} Predictions view model.
+ */
+async function getPredictionsData() {
+    const isFresh = cache.data && Date.now() - cache.fetchedAt < settings.cacheDurationMs;
+    if (isFresh) return cache.data;
+    try {
+        const contents = await Promise.all(settings.files.map(fetchEngineFile));
+        const files = settings.files.reduce((acc, name, i) => ({ ...acc, [name]: contents[i] }), {});
+        const data = buildViewModel(files);
+        cache = { data: data, fetchedAt: Date.now() };
+        return data;
+    } catch (error) {
+        // serve the last good copy when the engine is briefly unreachable.
+        if (cache.data) return { ...cache.data, isStale: true };
+        throw new Error('getPredictionsData failed to load prediction engine files', { cause: error });
+    }
+}
+
+module.exports = getPredictionsData;
diff --git a/utils/predictions/getPredictionsSummary.js b/utils/predictions/getPredictionsSummary.js
new file mode 100644
index 0000000..83223ee
--- /dev/null
+++ b/utils/predictions/getPredictionsSummary.js
@@ -0,0 +1,29 @@
+const config = require('../../config.json');
+const getPredictionsData = require('./getPredictionsData');
+
+/**
+ * @description Returns the short prediction summary shown on the home page.
+ * @async
+ * @returns {Promise<Object>} Summary with isAvailable flag, top pole and win favourites.
+ */
+async function getPredictionsSummary() {
+    try {
+        const data = await getPredictionsData();
+        return {
+            isAvailable: true,
+            grandPrix: data.grandPrix,
+            isQualifyingDone: data.isQualifyingDone,
+            isSeasonOver: data.isSeasonOver,
+            hasPracticeData: data.hasPracticeData,
+            weather: data.weather,
+            pole: data.grid.slice(0, config.predictions.homeWidgetSize),
+            win: data.winFavourites.slice(0, config.predictions.homeWidgetSize),
+        };
+    } catch (error) {
+        // the home page must still render when the prediction engine is down.
+        console.error(new Error('getPredictionsSummary unavailable', { cause: error }));
+        return { isAvailable: false };
+    }
+}
+
+module.exports = getPredictionsSummary;
diff --git a/utils/predictions/predictionFormat.js b/utils/predictions/predictionFormat.js
new file mode 100644
index 0000000..a1f87ac
--- /dev/null
+++ b/utils/predictions/predictionFormat.js
@@ -0,0 +1,51 @@
+const config = require('../../config.json');
+
+// widths are rounded to twelfths so that every class exists in the Tailwind build (listed in predictions.ejs).
+const WIDTH_CLASSES = ['w-0', 'w-1/12', 'w-2/12', 'w-3/12', 'w-4/12', 'w-5/12', 'w-6/12', 'w-7/12', 'w-8/12', 'w-9/12', 'w-10/12', 'w-11/12', 'w-full'];
+const ORDINAL_SUFFIXES = { 1: 'st', 2: 'nd', 3: 'rd' };
+const DRIVER_IMAGE_URL = 'https://pitlaneinsider-data.alwaysdata.net/drivers_img';
+const FALLBACK_IMAGE = '/img/assets/pli-logo-dark.png';
+
+/**
+ * @description Formats a probability as a rounded percentage for display.
+ * @param {number|null} value - Probability between 0 and 1.
+ * @returns {string} Display text such as "18%" or "<1%".
+ */
+function probability(value) {
+    if (value === null || value === undefined) return '–';
+    if (value < config.predictions.minDisplayedProbability) return '<1%';
+    return `${Math.round(value * 100)}%`;
+}
+
+/**
+ * @description Picks the Tailwind width class of a bar relative to the largest value.
+ * @param {number} value - Probability of the row.
+ * @param {number} max - Largest probability of the table.
+ * @returns {string} Tailwind width class.
+ */
+function barWidth(value, max) {
+    const steps = WIDTH_CLASSES.length - 1;
+    const index = Math.round(((value || 0) / (max || 1)) * steps);
+    return WIDTH_CLASSES[Math.max(value > 0 ? 1 : 0, Math.min(steps, index))];
+}
+
+/**
+ * @description Returns an English ordinal such as 1st, 2nd or 11th.
+ * @param {number} n - Rank.
+ * @returns {string} Ordinal text.
+ */
+function ordinal(n) {
+    const isTeen = n % 100 >= 11 && n % 100 <= 13;
+    return `${n}${isTeen ? 'th' : ORDINAL_SUFFIXES[n % 10] || 'th'}`;
+}
+
+/**
+ * @description Returns the photo URL of a driver, or the site logo when unknown.
+ * @param {Object} driver - Driver with an optional f1db driverId.
+ * @returns {string} Image URL.
+ */
+function driverPhoto(driver) {
+    return driver && driver.driverId ? `${DRIVER_IMAGE_URL}/${driver.driverId}.webp` : FALLBACK_IMAGE;
+}
+
+module.exports = { probability, barWidth, ordinal, driverPhoto };
