+
+                            <% if (!p.isSeasonOver && p.sessions) { %>
+                            <div>
+                                <h3 class="font-bold text-base mb-2"><%= __('predictions.weekend') %></h3>
+                                <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-sm">
+                                    <% const names = { FP1: 'Practice 1', FP2: 'Practice 2', FP3: 'Practice 3', SQ: 'Sprint quali', S: 'Sprint', Q: 'Qualifying', R: 'Race' }; %> <% ['FP1', 'SQ', 'FP2', 'S', 'FP3', 'Q', 'R'].filter(k => p.sessions[k]).forEach(k => { %>
