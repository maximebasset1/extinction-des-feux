+<% if (typeof predictionsSummary !== 'undefined') { %>
+<section class="bg-s-<%= theme %> rounded-3xl p-4 md:p-6 mt-4">
+    <% if (!predictionsSummary.isAvailable) { %>
+    <p class="text-sm text-t-s-<%= theme %> m-0"><%= __('predictions.unavailable') %></p>
+    <% } else { %>
+    <% const s = predictionsSummary; %>
+    <div class="flex items-center justify-between mb-4">
+        <a href="/predictions" class="font-bold text-lg hover:underline"><%= __('predictions.title') %> - <%= s.grandPrix.name %></a>
+        <a href="/predictions" class="text-sm text-main-color hover:underline"><%= __('predictions.see_all') %></a>
+    </div>
+    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
+        <% [{ title: __('predictions.pole'), list: s.pole }, { title: __('predictions.win'), list: s.win }].forEach(block => { %>
+        <div>
+            <p class="text-sm font-bold text-t-s-<%= theme %> mt-0 mb-2"><%= block.title %></p>
+            <div class="flex flex-col gap-2">
+                <% block.list.forEach((d, i) => { %>
+                <a href="<%= d.driverId ? '/driver/' + d.driverId : '/predictions' %>" class="flex items-center justify-between p-2 rounded-2xl bg-gray-500/10 hover:bg-gray-500/15 transition">
+                    <span class="flex items-center gap-3">
+                        <span class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs <%= i === 0 ? 'gold text-black' : 'bg-b-' + theme %>"><%= i + 1 %></span>
+                        <img src="<%= predictionFormat.driverPhoto(d) %>" alt="<%= d.lastName %>" class="h-10 w-10 object-cover rounded-full border border-gray-400/20" />
+                        <span class="flex items-center gap-2 font-bold"><span class="inline-block h-4 w-1 rounded-sm <%= d.constructorId ? 'bg-' + d.constructorId : 'bg-gray-500' %>"></span><%= d.lastName %></span>
+                    </span>
+                    <span class="font-wide text-lg pr-2"><%= predictionFormat.probability(d.probability) %></span>
+                </a>
+                <% }) %>
+            </div>
+        </div>
+        <% }) %>
+    </div>
+    <% } %>
+</section>
+<% } %>
