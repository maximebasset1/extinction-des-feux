diff --git a/app.js b/app.js
index 769e9e1..038c8f6 100644
--- a/app.js
+++ b/app.js
@@ -19,6 +19,8 @@ app.set('view engine', 'ejs');
 //     debug: true // Force the display of compiled code in the console
 // });
 
+app.locals.predictionFormat = require('./utils/predictions/predictionFormat'); // display helpers shared by prediction views
+
 app.use(express.json());
 app.use(express.urlencoded({ extended: false }));
 app.use(express.static(path.join(__dirname, 'public')));
@@ -111,12 +113,14 @@ app.use(async (req, res, next) => {
 
 const getHomeData = require("./utils/home/getHomeData"); // call getHomeData function from utils/home/getHomeData.js
 const getNewsHomePage = require("./utils/news/getNewsHomePage"); // call getNewsHomePage function from utils/news/getNewsHomePage.js
+const getPredictionsSummary = require("./utils/predictions/getPredictionsSummary"); // call getPredictionsSummary function from utils/predictions/getPredictionsSummary.js
 
 app.get("/", async (req, res) => { // home page
     try {
         var homeData = await getHomeData();
         var newsHomePage = await getNewsHomePage();
-        res.render("home/home", { homeData: homeData.homeData, newsFront: newsHomePage });
+        var predictionsSummary = await getPredictionsSummary();
+        res.render("home/home", { homeData: homeData.homeData, newsFront: newsHomePage, predictionsSummary: predictionsSummary });
     } catch (error) {
         res.render('security/error', { textError: 'base route, error during processing', error: error });
     }
@@ -149,6 +153,9 @@ app.use('/', liveRoutes);
 const newsRoutes = require('./routes/news'); // call newsRoutes function from routes/news.js
 app.use('/', newsRoutes);
 
+const predictionsRoutes = require('./routes/predictions'); // call predictionsRoutes function from routes/predictions.js
+app.use('/', predictionsRoutes);
+
 const aboutRoutes = require('./routes/about'); // call aboutRoutes function from routes/about.js
 app.use('/', aboutRoutes);
 
