+                <section class="bg-s-<%= theme %> rounded-3xl p-4 md:p-6">
+                    <h3 class="font-bold text-lg mb-4"><%= __('predictions.all_drivers') %></h3>
+                    <% const maxPole = Math.max(...p.field.map(d => d.probability || 0)); const maxWin = Math.max(...p.field.map(d => d.winProbability || 0)); %>
+                    <div class="overflow-x-auto">
+                        <table class="w-full text-sm">
