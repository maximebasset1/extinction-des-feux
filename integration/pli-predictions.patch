+                                    </li>
+                                    <% }) %>
+                                </ul>
+                                <p class="text-xs text-t-s-<%= theme %> mt-2 mb-0"><%= __('predictions.local_time') %><% if (p.isScheduleEstimated) { %> <%= __('predictions.estimated_schedule') %><% } %><% if (p.weather) { %> <%= __('predictions.rain_note') %><% } %></p>
