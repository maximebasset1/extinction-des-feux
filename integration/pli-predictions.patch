+                                    <li class="bg-b-<%= theme %> rounded-2xl px-3 py-2" data-session-time="<%= p.sessions[k] %>">
+                                        <span class="block font-bold"><%= names[k] %></span>
+                                        <span class="block text-t-s-<%= theme %> js-local-time"><%= p.sessions[k].replace('T', ' ').replace('Z', ' UTC') %></span>
+                                        <% if (w) { %>
+                                        <span class="block text-xs <%= w.pluie >= p.rainDisplayThreshold ? 'text-sky-400' : 'text-t-s-' + theme %>"><%= w.temperature !== null ? Math.round(w.temperature) + '°C, ' : '' %><%= w.pluie >= p.rainDisplayThreshold ? Math.round(w.pluie * 100) + '% ' + __('predictions.rain_risk') : __('predictions.dry') %></span>
